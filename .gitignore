# =============================================================================
# .gitignore for trading-36 (production and exploration branches)
# =============================================================================
# Prevents sensitive, temporary, experimental, or heavy files from being tracked.
# Keeps version control focused on production-ready logic, scripts, reports, and configs.
# =============================================================================

# === Environment and secrets ===
.env
.keys.sh
.trading.env

# === Python cache and compiled artifacts ===
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.pkl
*.h5
*.npy
*.tmp
*.bak

# === Raw data and derived datasets ===
data/
modelos/ml/tmp/

# === Logs and runtime artifacts ===
logs/
*.log

# === Notebooks ===
# Ignore all notebooks by default
notebooks/*
# Allow only production notebooks to be tracked
!notebooks/production/
!notebooks/production/**
# Explicitly ignore exploration notebooks
notebooks/exploration/
notebooks/exploration/**

# Ignore checkpoint and auto-backup files
*.ipynb
.ipynb_checkpoints/

# === Reports ===
# Ignore debug, non-prod, and auto-generated files
reports/backtest_*/
reports/debug/
reports/logs/
reports/ordenes_enriquecidas/
reports/senales_ml/
reports/summary/
*.html
*.xlsx

# Allow only select published heuristics reports
!reports/senales_heuristicas/exploracion/*.csv
!reports/senales_heuristicas/diarias/top50_oportunidades_*.csv
reports/senales_heuristicas/diarias/*_senales_diarias.csv

# === Config files ===
config/*test.json
config/error.json

# === IDE/editor/workspace files ===
.trash/
.vscode/
.idea/

# === Exceptions for tracked agent logic ===
!trading_agents/agent1/**
